<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog 
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!-- Enable UUID Extension -->
    <changeSet id="001-enable-uuid-ossp" author="akim.omar">
        <sql>CREATE EXTENSION IF NOT EXISTS "uuid-ossp";</sql>
    </changeSet>

    <!-- Enum Types -->
    <changeSet id="002-enum-types" author="akim.omar">
        <sql>CREATE TYPE "UserRole" AS ENUM ('Client', 'Admin');</sql>
        <sql>CREATE TYPE "OrderStatus" AS ENUM ('Pending', 'SentToAdmin', 'Confirmed', 'Cancelled');</sql>
        <sql>CREATE TYPE "VerificationType" AS ENUM ('Email', 'Phone');</sql>
    </changeSet>

    <!-- Users Table -->
    <changeSet id="003-create-users" author="akim.omar">
        <createTable tableName="Users">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="FullName" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="Phone" type="VARCHAR(20)"/>
            <column name="Email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="Password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="Role" type="UserRole" defaultValue="Client"/>
            <column name="IsEmailVerified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="IsPhoneVerified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UpdatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="DeletedAt" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint columnNames="Phone" tableName="Users" constraintName="uk_users_phone"/>
    </changeSet>

    <!-- Dictionaries Table -->
    <changeSet id="004-create-dictionaries" author="akim.omar">
        <createTable tableName="Dictionaries">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="Type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="NameRu" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NameKz" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="Code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="Value" type="VARCHAR(100)"/>
            <column name="DescriptionRu" type="TEXT"/>
            <column name="DescriptionKz" type="TEXT"/>
            <column name="ParentId" type="UUID">
                <constraints foreignKeyName="FK_Dictionaries_ParentId" references="Dictionaries(Id)" />
            </column>
            <column name="IsActive" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Files Table -->
    <changeSet id="005-create-files" author="akim.omar">
        <createTable tableName="Files">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="Url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="PublicId" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="FileName" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="Size" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="MimeType" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UpdatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Products Table -->
    <changeSet id="006-create-products" author="akim.omar">
        <createTable tableName="Products">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="CategoryId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Products_Dictionaries_CategoryId" references="Dictionaries(Id)" />
            </column>
            <column name="MaterialId" type="UUID">
                <constraints foreignKeyName="FK_Products_Dictionaries_MaterialId" references="Dictionaries(Id)" />
            </column>
            <column name="NameRu" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NameKz" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="Code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="DescriptionRu" type="TEXT"/>
            <column name="DescriptionKz" type="TEXT"/>
            <column name="Price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="IsAvailable" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="IsFeatured" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UpdatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ProductFiles Table -->
    <changeSet id="007-create-productfiles" author="akim.omar">
        <createTable tableName="ProductFiles">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="ProductId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_ProductFiles_Products_ProductId" references="Products(Id)" />
            </column>
            <column name="FileId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_ProductFiles_Files_FileId" references="Files(Id)" />
            </column>
            <column name="IsAddition" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <!-- ProductColors Table -->
    <changeSet id="008-create-productcolors" author="akim.omar">
        <createTable tableName="ProductColors">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="ProductId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_ProductColors_Products_ProductId" references="Products(Id)" />
            </column>
            <column name="ColorId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_ProductColors_Dictionaries_ColorId" references="Dictionaries(Id)" />
            </column>
            <column name="IsAvailable" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
    </changeSet>

    <!-- ProductSizes Table -->
    <changeSet id="009-create-productsizes" author="akim.omar">
        <createTable tableName="ProductSizes">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="ProductId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_ProductSizes_Products_ProductId" references="Products(Id)" />
            </column>
            <column name="SizeId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_ProductSizes_Dictionaries_SizeId" references="Dictionaries(Id)" />
            </column>
            <column name="IsAvailable" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
    </changeSet>

    <!-- Favorites Table -->
    <changeSet id="010-create-favorites" author="akim.omar">
        <createTable tableName="Favorites">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="UserId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Favorites_Users_UserId" references="Users(Id)" />
            </column>
            <column name="ProductId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Favorites_Products_ProductId" references="Products(Id)" />
            </column>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint columnNames="UserId, ProductId" tableName="Favorites" constraintName="UK_Favorites_UserId_ProductId"/>
    </changeSet>

    <!-- Carts Table -->
    <changeSet id="011-create-carts" author="akim.omar">
        <createTable tableName="Carts">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="UserId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Carts_Users_UserId" references="Users(Id)" />
            </column>
            <column name="ProductId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Carts_Products_ProductId" references="Products(Id)" />
            </column>
            <column name="Quantity" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="SelectedColorId" type="UUID">
                <constraints foreignKeyName="FK_Carts_Dictionaries_SelectedColorId" references="Dictionaries(Id)" />
            </column>
            <column name="SelectedSizeId" type="UUID">
                <constraints foreignKeyName="FK_Carts_Dictionaries_SelectedSizeId" references="Dictionaries(Id)" />
            </column>
            <column name="Notes" type="TEXT"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UpdatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint columnNames="UserId, ProductId" tableName="Carts" constraintName="UK_Carts_UserId_ProductId"/>
        <addCheckConstraint tableName="Carts" constraintName="CK_Carts_Quantity_Positive" checkConstraint="Quantity > 0"/>
    </changeSet>

    <!-- Addresses Table -->
    <changeSet id="012-create-addresses" author="akim.omar">
        <createTable tableName="Addresses">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="UserId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Addresses_Users_UserId" references="Users(Id)" />
            </column>
            <column name="Title" type="VARCHAR(100)"/>
            <column name="City" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="Street" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="HouseNumber" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="Apartment" type="VARCHAR(20)"/>
            <column name="Notes" type="TEXT"/>
            <column name="IsDefault" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Orders Table -->
    <changeSet id="013-create-orders" author="akim.omar">
        <createTable tableName="Orders">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="OrderNumber" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="UserId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Orders_Users_UserId" references="Users(Id)" />
            </column>
            <column name="DeliveryAddressId" type="UUID">
                <constraints foreignKeyName="FK_Orders_Addresses_DeliveryAddressId" references="Addresses(Id)" />
            </column>
            <column name="Status" type="OrderStatus" defaultValue="Pending"/>
            <column name="TotalAmount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="DeliveryFee" type="DECIMAL(8,2)" defaultValueNumeric="0"/>
            <column name="Notes" type="TEXT"/>
            <column name="AdminNotes" type="TEXT"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UpdatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- OrderItems Table -->
    <changeSet id="014-create-orderitems" author="akim.omar">
        <createTable tableName="OrderItems">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="OrderId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_OrderItems_Orders_OrderId" references="Orders(Id)" />
            </column>
            <column name="ProductId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_OrderItems_Products_ProductId" references="Products(Id)" />
            </column>
            <column name="Quantity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="UnitPrice" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="TotalPrice" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="SelectedColorId" type="UUID">
                <constraints foreignKeyName="FK_OrderItems_Dictionaries_SelectedColorId" references="Dictionaries(Id)" />
            </column>
            <column name="SelectedSizeId" type="UUID">
                <constraints foreignKeyName="FK_OrderItems_Dictionaries_SelectedSizeId" references="Dictionaries(Id)" />
            </column>
            <column name="ItemNotes" type="TEXT"/>
        </createTable>
        <addCheckConstraint tableName="OrderItems" constraintName="CK_OrderItems_Quantity_Positive" checkConstraint="Quantity > 0"/>
    </changeSet>

    <!-- Reviews Table -->
    <changeSet id="015-create-reviews" author="akim.omar">
        <createTable tableName="Reviews">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="UserId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Reviews_Users_UserId" references="Users(Id)" />
            </column>
            <column name="ProductId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Reviews_Products_ProductId" references="Products(Id)" />
            </column>
            <column name="Rating" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="Comment" type="TEXT"/>
            <column name="Photos" type="TEXT"/>
            <column name="IsVerified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint columnNames="UserId, ProductId" tableName="Reviews" constraintName="UK_Reviews_UserId_ProductId"/>
        <addCheckConstraint tableName="Reviews" constraintName="CK_Reviews_Rating_Range" checkConstraint="Rating >= 1 AND Rating <= 5"/>
    </changeSet>

    <!-- Verifications Table -->
    <changeSet id="016-create-verifications" author="akim.omar">
        <createTable tableName="Verifications">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="UserId" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_Verifications_Users_UserId" references="Users(Id)" />
            </column>
            <column name="Type" type="VerificationType">
                <constraints nullable="false"/>
            </column>
            <column name="Contact" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="Code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="ExpiresAt" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="IsVerified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="AttemptCount" type="INTEGER" defaultValueNumeric="0"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Logs Table -->
    <changeSet id="017-create-logs" author="akim.omar">
        <createTable tableName="Logs">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="Level" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="Message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="Exception" type="TEXT"/>
            <column name="UserId" type="UUID">
                <constraints foreignKeyName="FK_Logs_Users_UserId" references="Users(Id)" />
            </column>
            <column name="RequestPath" type="VARCHAR(500)"/>
            <column name="RequestMethod" type="VARCHAR(10)"/>
            <column name="IPAddress" type="VARCHAR(45)"/>
            <column name="UserAgent" type="TEXT"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Indexes -->
    <changeSet id="018-create-indexes" author="akim.omar">
        <createIndex tableName="Users" indexName="IX_Users_Email">
            <column name="Email"/>
        </createIndex>
        <createIndex tableName="Users" indexName="IX_Users_Phone">
            <column name="Phone"/>
        </createIndex>
        <createIndex tableName="Dictionaries" indexName="IX_Dictionaries_Type">
            <column name="Type"/>
        </createIndex>
        <createIndex tableName="Products" indexName="IX_Products_CategoryId">
            <column name="CategoryId"/>
        </createIndex>
        <createIndex tableName="Products" indexName="IX_Products_Code">
            <column name="Code"/>
        </createIndex>
        <createIndex tableName="Orders" indexName="IX_Orders_UserId">
            <column name="UserId"/>
        </createIndex>
        <createIndex tableName="Orders" indexName="IX_Orders_Status">
            <column name="Status"/>
        </createIndex>
        <createIndex tableName="Verifications" indexName="IX_Verifications_Contact_Type">
            <column name="Contact"/>
            <column name="Type"/>
        </createIndex>
        <createIndex tableName="Logs" indexName="IX_Logs_Level_CreatedAt">
            <column name="Level"/>
            <column name="CreatedAt"/>
        </createIndex>
    </changeSet>

