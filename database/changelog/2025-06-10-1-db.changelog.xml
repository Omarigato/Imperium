<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog 
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!-- Enable UUID Extension -->
    <changeSet id="001-enable-uuid-ossp" author="akim.omar">
        <sql>CREATE EXTENSION IF NOT EXISTS "uuid-ossp";</sql>
    </changeSet>

    <!-- Enum Types -->
    <changeSet id="002-enum-types" author="akim.omar">
        <sql>CREATE TYPE UserRole AS ENUM ('Client', 'Admin');</sql>
        <sql>CREATE TYPE OrderStatus AS ENUM ('Pending', 'SentToAdmin', 'Confirmed', 'Cancelled');</sql>
        <sql>CREATE TYPE VerificationType AS ENUM ('Email', 'Phone');</sql>
    </changeSet>

    <!-- Users Table -->
    <changeSet id="003-create-users" author="akim.omar">
        <createTable tableName="Users">
            <column name="Id" type="UUID">
                <constraints primaryKey="true"/>
                <defaultValueComputed>uuid_generate_v4()</defaultValueComputed>
            </column>
            <column name="FullName" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="Phone" type="VARCHAR(20)"/>
            <column name="Email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="Password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="Role" type="UserRole" defaultValue="Client"/>
            <column name="IsEmailVerified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="IsPhoneVerified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="CreatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UpdatedAt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="DeletedAt" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint columnNames="Phone" tableName="Users" constraintName="uk_users_phone"/>
    </changeSet>

    <!-- Indexes -->
    <changeSet id="004-indexes-users" author="akim.omar">
        <createIndex tableName="Users" indexName="IX_Users_Email">
            <column name="Email"/>
        </createIndex>
        <createIndex tableName="Users" indexName="IX_Users_Phone">
            <column name="Phone"/>
        </createIndex>
    </changeSet>

    <!-- Initial Admin User -->
    <changeSet id="005-insert-admin-user" author="akim.omar" context="data">
        <insert tableName="Users">
            <column name="FullName" value="Admin User"/>
            <column name="Email" value="admin@imperium.kz"/>
            <!-- Password: admin123 -->
            <column name="Password" value="$2a$11$8F8VjyCzOr7h/jVhV6KsKu3i0C8DnGGZYMGZ5N5C4zDGJ6K7qE.pq"/>
            <column name="Role" value="Admin"/>
            <column name="IsEmailVerified" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
